{
  "op": "group_by",
  "mode": "hash",
  "keys": [
    "c.region"
  ],
  "aggregates": [
    [
      "count",
      "*",
      "n"
    ]
  ],
  "child": {
    "op": "project",
    "columns": [
      "c.region"
    ],
    "child": {
      "op": "filter",
      "condition": "o.amount > 700",
      "child": {
        "op": "project",
        "columns": [
          "c.region",
          "o.amount"
        ],
        "child": {
          "op": "nested_loop_join",
          "condition": "c.cust_id = o.cust_id",
          "left": {
            "op": "rename",
            "to": "c",
            "child": {
              "op": "project",
              "columns": [
                "Customers.cust_id",
                "Customers.region"
              ],
              "child": {
                "op": "seqscan",
                "table": "Customers"
              }
            }
          },
          "right": {
            "op": "rename",
            "to": "o",
            "child": {
              "op": "project",
              "columns": [
                "Orders.cust_id",
                "Orders.amount"
              ],
              "child": {
                "op": "seqscan",
                "table": "Orders"
              }
            }
          }
        }
      }
    }
  }
}