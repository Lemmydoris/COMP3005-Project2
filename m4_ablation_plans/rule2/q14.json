{
  "op": "project",
  "columns": [
    "c.cust_id",
    "o.order_id"
  ],
  "child": {
    "op": "filter",
    "condition": "c.region = 3",
    "child": {
      "op": "project",
      "columns": [
        "c.cust_id",
        "c.region",
        "o.order_id"
      ],
      "child": {
        "op": "filter",
        "condition": "o.amount > 900",
        "child": {
          "op": "project",
          "columns": [
            "c.cust_id",
            "c.region",
            "o.order_id",
            "o.amount"
          ],
          "child": {
            "op": "nested_loop_join",
            "condition": "c.cust_id = o.cust_id",
            "left": {
              "op": "rename",
              "to": "c",
              "child": {
                "op": "project",
                "columns": [
                  "Customers.cust_id",
                  "Customers.region"
                ],
                "child": {
                  "op": "seqscan",
                  "table": "Customers"
                }
              }
            },
            "right": {
              "op": "rename",
              "to": "o",
              "child": {
                "op": "project",
                "columns": [
                  "Orders.order_id",
                  "Orders.cust_id",
                  "Orders.amount"
                ],
                "child": {
                  "op": "seqscan",
                  "table": "Orders"
                }
              }
            }
          }
        }
      }
    }
  }
}