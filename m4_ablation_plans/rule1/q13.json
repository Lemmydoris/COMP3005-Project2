{
  "op": "project",
  "columns": [
    "p.product_id",
    "s.supplier_id"
  ],
  "child": {
    "op": "filter",
    "condition": "p.supplier_id = s.supplier_id AND s.region = 1",
    "child": {
      "op": "nested_loop_join",
      "condition": "p.product_id = p.product_id",
      "left": {
        "op": "rename",
        "to": "p",
        "child": {
          "op": "project",
          "columns": [
            "Products.product_id",
            "Products.supplier_id"
          ],
          "child": {
            "op": "seqscan",
            "table": "Products"
          }
        }
      },
      "right": {
        "op": "rename",
        "to": "s",
        "child": {
          "op": "project",
          "columns": [
            "Suppliers.supplier_id",
            "Suppliers.region"
          ],
          "child": {
            "op": "seqscan",
            "table": "Suppliers"
          }
        }
      }
    }
  }
}