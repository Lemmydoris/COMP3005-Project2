  "op": "group_by",
  "mode": "sort",
  "keys": [
    "c.region"
  ],
  "aggregates": [
    [
      "count",
      "*",
      "n"
    ]
  ],
  "child": {
    "op": "project",
    "columns": [
      "c.region"
    ],
    "child": {
