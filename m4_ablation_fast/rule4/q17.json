{
  "op": "project",
  "columns": [
    "p.product_id"
  ],
  "child": {
    "op": "filter",
    "condition": "p.category = 7",
    "child": {
      "op": "project",
      "columns": [
        "p.product_id",
        "p.category"
      ],
      "child": {
        "op": "filter",
        "condition": "p.price > 600",
        "child": {
          "op": "rename",
          "to": "p",
          "child": {
            "op": "project",
            "columns": [
              "Products.product_id",
              "Products.category",
              "Products.price"
            ],
            "child": {
              "op": "seqscan",
              "table": "Products"
            }
          }
        }
      }
    }
  }
}