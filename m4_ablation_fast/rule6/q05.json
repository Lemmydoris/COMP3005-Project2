{
  "op": "project",
  "columns": [
    "c.cust_id",
    "o.order_id"
  ],
  "child": {
    "op": "nested_loop_join",
    "condition": "c.cust_id = o.cust_id",
    "left": {
      "op": "filter",
      "condition": "c.region = 1",
      "child": {
        "op": "seqscan",
        "table": "Customers",
        "alias": "c"
      }
    },
    "right": {
      "op": "seqscan",
      "table": "Orders",
      "alias": "o"
    }
  }
}