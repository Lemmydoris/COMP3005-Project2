{
  "op": "project",
  "columns": [
    "o.order_id",
    "p.product_id"
  ],
  "child": {
    "op": "nested_loop_join",
    "condition": "o.product_id = p.product_id",
    "left": {
      "op": "filter",
      "condition": "p.category = 3",
      "child": {
        "op": "seqscan",
        "table": "Products",
        "alias": "p"
      }
    },
    "right": {
      "op": "seqscan",
      "table": "Orders",
      "alias": "o"
    }
  }
}