{
  "op": "project",
  "columns": [
    "c.cust_id",
    "o.order_id",
    "p.product_id"
  ],
  "child": {
    "op": "nested_loop_join",
    "condition": "o.product_id = p.product_id",
    "left": {
      "op": "filter",
      "condition": "c.region = 1",
      "child": {
        "op": "nested_loop_join",
        "condition": "c.cust_id = o.cust_id",
        "left": {
          "op": "seqscan",
          "table": "Customers",
          "alias": "c"
        },
        "right": {
          "op": "seqscan",
          "table": "Orders",
          "alias": "o"
        }
      }
    },
    "right": {
      "op": "filter",
      "condition": "p.category = 3",
      "child": {
        "op": "seqscan",
        "table": "Products",
        "alias": "p"
      }
    }
  }
}