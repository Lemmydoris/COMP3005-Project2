{
  "op": "group_by",
  "mode": "sort",
  "keys": [
    "c.region"
  ],
  "aggregates": [
    [
      "count",
      "*",
      "n"
    ]
  ],
  "child": {
    "op": "nested_loop_join",
    "condition": "c.cust_id = o.cust_id",
    "left": {
      "op": "filter",
      "condition": "o.amount > 700",
      "child": {
        "op": "seqscan",
        "table": "Orders",
        "alias": "o"
      }
    },
    "right": {
      "op": "seqscan",
      "table": "Customers",
      "alias": "c"
    }
  }
}