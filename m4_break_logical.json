{
  "op": "project",
  "columns": [
    "c.id",
    "c.p1",
    "c.p2",
    "c.p3",
    "c.p4",
    "c.p5",
    "c.p6",
    "c.p7",
    "p.p1",
    "p.p2",
    "p.p3",
    "p.p4",
    "p.p5",
    "p.p6",
    "p.p7"
  ],
  "child": {
    "op": "select",
    "condition": "c.region = 1 AND c.segment = 1",
    "child": {
      "op": "join",
      "condition": "c.id = p.id",
      "left": {
        "op": "rename",
        "to": "c",
        "child": {
          "op": "scan",
          "table": "CorrCustomers"
        }
      },
      "right": {
        "op": "rename",
        "to": "p",
        "child": {
          "op": "scan",
          "table": "CorrProbe"
        }
      }
    }
  }
}