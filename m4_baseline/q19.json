{
  "op": "project",
  "columns": [
    "c.region",
    "n"
  ],
  "child": {
    "op": "group_by",
    "mode": "sort",
    "keys": [
      "c.region"
    ],
    "aggregates": [
      [
        "count",
        "*",
        "n"
      ]
    ],
    "child": {
      "op": "filter",
      "condition": "o.amount > 700",
      "child": {
        "op": "nested_loop_join",
        "condition": "c.cust_id = o.cust_id",
        "left": {
          "op": "rename",
          "to": "c",
          "child": {
            "op": "seqscan",
            "table": "Customers"
          }
        },
        "right": {
          "op": "rename",
          "to": "o",
          "child": {
            "op": "seqscan",
            "table": "Orders"
          }
        }
      }
    }
  }
}