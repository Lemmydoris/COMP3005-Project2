{
  "op": "project",
  "columns": [
    "p.product_id",
    "s.supplier_id"
  ],
  "child": {
    "op": "filter",
    "condition": "p.supplier_id = s.supplier_id AND s.region = 1",
    "child": {
      "op": "nested_loop_join",
      "condition": "1 = 1",
      "left": {
        "op": "rename",
        "to": "p",
        "child": {
          "op": "seqscan",
          "table": "Products"
        }
      },
      "right": {
        "op": "rename",
        "to": "s",
        "child": {
          "op": "seqscan",
          "table": "Suppliers"
        }
      }
    }
  }
}