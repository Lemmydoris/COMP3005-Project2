{
  "op": "project",
  "columns": [
    "c.cust_id",
    "o.order_id",
    "p.product_id"
  ],
  "child": {
    "op": "filter",
    "condition": "c.region = 1 AND p.category = 3",
    "child": {
      "op": "nested_loop_join",
      "condition": "o.product_id = p.product_id",
      "left": {
        "op": "nested_loop_join",
        "condition": "c.cust_id = o.cust_id",
        "left": {
          "op": "rename",
          "to": "c",
          "child": {
            "op": "seqscan",
            "table": "Customers"
          }
        },
        "right": {
          "op": "rename",
          "to": "o",
          "child": {
            "op": "seqscan",
            "table": "Orders"
          }
        }
      },
      "right": {
        "op": "rename",
        "to": "p",
        "child": {
          "op": "seqscan",
          "table": "Products"
        }
      }
    }
  }
}