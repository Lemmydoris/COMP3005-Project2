{
  "op": "project",
  "columns": [
    "c.cust_id",
    "o.order_id"
  ],
  "child": {
    "op": "nested_loop_join",
    "condition": "c.cust_id = o.cust_id",
    "left": {
      "op": "project",
      "columns": [
        "c.cust_id"
      ],
      "child": {
        "op": "filter",
        "condition": "c.region = 1",
        "child": {
          "op": "project",
          "columns": [
            "c.cust_id",
            "c.region"
          ],
          "child": {
            "op": "filter",
            "condition": "c.segment = 1",
            "child": {
              "op": "rename",
              "to": "c",
              "child": {
                "op": "project",
                "columns": [
                  "Customers.cust_id",
                  "Customers.region",
                  "Customers.segment"
                ],
                "child": {
                  "op": "seqscan",
                  "table": "Customers"
                }
              }
            }
          }
        }
      }
    },
    "right": {
      "op": "rename",
      "to": "o",
      "child": {
        "op": "project",
        "columns": [
          "Orders.order_id",
          "Orders.cust_id"
        ],
        "child": {
          "op": "seqscan",
          "table": "Orders"
        }
      }
    }
  }
}